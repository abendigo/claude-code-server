FROM node:24-slim

# The VR hub: serves the WebXR client (vr/client) plus a small API (speech to
# text). It never touches docker.sock or user containers -- terminals reach
# the gateway's ttyd directly from the browser. Deliberately its own image so
# that it can restart/redeploy independently of the gateway.
WORKDIR /app
COPY vr/package.json vr/package-lock.json ./
RUN npm ci --omit=dev

COPY vr/server ./server
# The client that ships in this image, plus when it was built. The hub serves
# this unless someone has run vr-sync into the /srv/client volume *after* this
# build (see vr/server/server.js), so a deploy always wins over stale live
# edits, and live edits win until the next deploy. The stamp layer is only
# rebuilt when the client changes, which is exactly when it should move.
COPY vr/client /app/client-default
RUN date +%s > /app/client-built
COPY vr/entrypoint.sh /entrypoint.sh

# Live-edit overlay: written only by vr-sync from the VR_DEV_USER's worker.
# World-writable so a new named volume inherits permissions that let that
# (differently-uid'd) worker write to it.
RUN chmod +x /entrypoint.sh && mkdir -p /srv/client && chmod 777 /srv/client

USER node
ENV NODE_ENV=production PORT=8080
EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]
