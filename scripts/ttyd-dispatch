#!/bin/bash
# Entry point ttyd runs for each new browser connection on the gateway.
# ttyd is started with `-H Remote-User`, which makes it read the
# Authelia-authenticated username Traefik forwards and expose it to this
# script as $TTYD_USER (see ttyd's --auth-header option). Port 7681 is only
# reachable through Traefik+Authelia -- it is never published directly --
# so this header can be trusted.
set -uo pipefail

RAW_USER="${TTYD_USER:-}"

# Authelia authenticates users as email addresses (e.g. mark@oosterveld.org).
# Docker container/volume names can't contain '@', so normalize the identity
# into a safe slug: lowercase, replace every char outside [a-z0-9_.-] with
# '-', collapse repeats, and trim leading/trailing separators. The full
# address is preserved (mark@oosterveld.org -> mark-oosterveld.org) so
# distinct identities never collide onto the same workspace.
SLUG="$(printf '%s' "$RAW_USER" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9_.-]+/-/g; s/-{2,}/-/g; s/^[-._]+//; s/[-._]+$//' \
    | cut -c1-64)"

# Fail closed: an empty/garbage header leaves nothing to key a container on,
# so refuse rather than guess. (A missing header never reaches here -- ttyd
# rejects it with HTTP 407 before spawning this script.)
if [ -z "$SLUG" ]; then
    echo "Access denied: no valid authenticated user."
    sleep 2
    exit 1
fi

exec /usr/local/bin/dispatch-to-worker "$SLUG"
