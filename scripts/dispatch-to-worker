#!/bin/bash
# Get-or-create the worker container for a given username, then exec into
# it. Shared by ttyd-dispatch today; a future ssh-dispatch can reuse it too.
#
# Runs as root on the gateway (needs the mounted docker.sock). The caller is
# responsible for validating $1 against a strict charset first -- this
# script trusts its argument enough to use it in container/volume names and
# docker exec.
set -euo pipefail

NAME="$1"
CONTAINER="claude-code-user-${NAME}"
VOLUME="workspace-${NAME}"
IMAGE="${WORKER_IMAGE:-ghcr.io/abendigo/claude-code-server-worker:latest}"
STATE_DIR="/var/lib/claude-code-dispatch"

# $NAME (ttyd-dispatch's SLUG) allows dots, e.g. "mark-oosterveld.org" --
# fine for container/volume names but not for the VS Code tunnel name: the
# tunnel service validates it as a "Labels" field against
# '[\w-=]{1,50}' (no dots) and fails the whole tunnel with an HTTP 400 if it
# doesn't match. Every email-derived slug has a dot in the domain, so this
# bites every user, not just edge cases -- build a separate tunnel-safe
# name instead of reusing $NAME directly.
TUNNEL_SUFFIX="$(printf '%s' "$NAME" | tr -c 'A-Za-z0-9_=-' '-')"

mkdir -p "$STATE_DIR"

if ! docker inspect "$CONTAINER" >/dev/null 2>&1; then
    echo "No environment yet for '${NAME}' -- creating one (this can take a minute on first login)..."
    docker run -d \
        --name "$CONTAINER" \
        --label claude-code.managed=true \
        --label "claude-code.user=${NAME}" \
        --privileged \
        --stop-timeout 20 \
        -e ANTHROPIC_API_KEY \
        -e TUNNEL_NAME="$(printf '%s' "${TUNNEL_NAME:-claude-code-server}-${TUNNEL_SUFFIX}" | cut -c1-50)" \
        -v "${VOLUME}:/workspace" \
        "$IMAGE" >/dev/null
elif [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER")" != "true" ]; then
    echo "Resuming environment for '${NAME}'..."
    docker start "$CONTAINER" >/dev/null
fi

# Record activity for the idle reaper, regardless of whether this was a
# fresh create, a resume, or just another connection to an already-running
# container.
date +%s > "${STATE_DIR}/${NAME}.lastseen"

# Wait for the worker's own entrypoint to have installed ttyd-session before
# handing the terminal in -- matters mainly right after a fresh create.
for _ in $(seq 1 30); do
    docker exec "$CONTAINER" test -x /usr/local/bin/ttyd-session 2>/dev/null && break
    sleep 1
done

exec docker exec -it -u claude -w /workspace -e "TTYD_USER=${NAME}" -e HOME=/workspace "$CONTAINER" /usr/local/bin/ttyd-session
