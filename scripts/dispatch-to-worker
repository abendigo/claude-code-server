#!/bin/bash
# Get-or-create the worker container for a given username, then exec into
# it. Shared by ttyd-dispatch today; a future ssh-dispatch can reuse it too.
#
#   dispatch-to-worker NAME            interactive terminal (ttyd-session, with a tty)
#   dispatch-to-worker NAME CMD [ARGS] run CMD (a program in /usr/local/bin) in the
#                                      worker over plain stdio, no tty -- used by the
#                                      agent gateway. Progress messages go to stderr
#                                      so stdout carries only CMD's output.
#
# Runs as root on the gateway (needs the mounted docker.sock). The caller is
# responsible for validating $1 against a strict charset first -- this
# script trusts its argument enough to use it in container/volume names and
# docker exec.
set -euo pipefail

NAME="$1"
shift
if [ "$#" -gt 0 ]; then AGENT_MODE=1; READY_CMD="$1"; else AGENT_MODE=; READY_CMD=ttyd-session; fi
say() { if [ -n "$AGENT_MODE" ]; then echo "$@" >&2; else echo "$@"; fi; }
CONTAINER="claude-code-user-${NAME}"
VOLUME="workspace-${NAME}"
IMAGE="${WORKER_IMAGE:-ghcr.io/abendigo/claude-code-server-worker:latest}"
STATE_DIR="${STATE_DIR:-/var/lib/claude-code-dispatch}"

# $NAME (ttyd-dispatch's SLUG) allows dots, e.g. "mark-oosterveld.org" --
# fine for container/volume names but not for the VS Code tunnel name: the
# tunnel service validates it as a "Labels" field against
# '[\w-=]{1,50}' (no dots) and fails the whole tunnel with an HTTP 400 if it
# doesn't match. Every email-derived slug has a dot in the domain, so this
# bites every user, not just edge cases -- build a separate tunnel-safe
# name instead of reusing $NAME directly.
TUNNEL_SUFFIX="$(printf '%s' "$NAME" | tr -c 'A-Za-z0-9_=-' '-')"

mkdir -p "$STATE_DIR"

# One designated user (the person developing the VR client) gets the vr-hub's
# live client volume mounted read-write, so they can edit what the hub serves
# without an image rebuild (see scripts/vr-sync). Everyone else is unaffected.
# Only takes effect when the container is *created*, not on resume.
EXTRA_ARGS=()
if [ -n "${VR_DEV_USER:-}" ] && [ "$NAME" = "$VR_DEV_USER" ]; then
    EXTRA_ARGS+=(-v "${VR_CLIENT_VOLUME:-claude-vr-client}:/workspace/vr-live")
fi

if ! docker inspect "$CONTAINER" >/dev/null 2>&1; then
    say "No environment yet for '${NAME}' -- creating one (this can take a minute on first login)..."
    docker run -d \
        --name "$CONTAINER" \
        --label claude-code.managed=true \
        --label "claude-code.user=${NAME}" \
        --privileged \
        --stop-timeout 20 \
        -e ANTHROPIC_API_KEY \
        -e TUNNEL_NAME="$(printf '%s' "${TUNNEL_NAME:-claude-code-server}-${TUNNEL_SUFFIX}" | cut -c1-50)" \
        -v "${VOLUME}:/workspace" \
        "${EXTRA_ARGS[@]}" \
        "$IMAGE" >/dev/null
elif [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER")" != "true" ]; then
    say "Resuming environment for '${NAME}'..."
    docker start "$CONTAINER" >/dev/null
fi

# Record activity for the idle reaper, regardless of whether this was a
# fresh create, a resume, or just another connection to an already-running
# container.
date +%s > "${STATE_DIR}/${NAME}.lastseen"

# Wait for the worker's own entrypoint to have installed ttyd-session before
# handing the terminal in -- matters mainly right after a fresh create.
for _ in $(seq 1 30); do
    docker exec "$CONTAINER" test -x "/usr/local/bin/${READY_CMD}" 2>/dev/null && break
    sleep 1
done

# The stamp above only proves *connecting* happened; without more, a session
# left open past IDLE_TIMEOUT_SECONDS looks idle to reap-idle-users and gets
# stopped out from under an active user (see project memory,
# reap_idle_active_session_fix). Keep refreshing it in the background for as
# long as this connection stays open -- ttyd spawns one of these processes
# per browser connection and it blocks on the docker exec below for the
# session's whole lifetime, so "this process is still running" is a good
# proxy for "still connected". The interval just needs to stay comfortably
# under REAP_INTERVAL_SECONDS (default 300s).
heartbeat() {
    while sleep 60; do
        date +%s > "${STATE_DIR}/${NAME}.lastseen"
    done
}
heartbeat &
heartbeat_pid=$!
trap 'kill "$heartbeat_pid" 2>/dev/null || true' EXIT

set +e
if [ -n "$AGENT_MODE" ]; then
    docker exec -i -u claude -w /workspace -e "TTYD_USER=${NAME}" -e HOME=/workspace "$CONTAINER" "/usr/local/bin/${READY_CMD}" "${@:2}"
else
    docker exec -it -u claude -w /workspace -e "TTYD_USER=${NAME}" -e HOME=/workspace "$CONTAINER" /usr/local/bin/ttyd-session
fi
exit_code=$?
set -e

# One last stamp on the way out so a quick reconnect after a brief
# disconnect isn't penalized either.
date +%s > "${STATE_DIR}/${NAME}.lastseen"

exit "$exit_code"
