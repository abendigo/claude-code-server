FROM node:24-slim

# This is a single user's dev environment -- one of these containers gets
# created per authenticated user by the gateway's dispatch-to-worker script.
# It gets --privileged (for its own private Docker-in-Docker daemon) but
# never the host's docker.sock, so it has no path to the host or to any
# other user's container.
RUN apt-get update && apt-get install -y \
    git \
    curl \
    sudo \
    gosu \
    tmux \
    docker.io \
    gh \
    sqlite3 \
    dnsutils \
    whois \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Install Claude Code globally
RUN npm install -g @anthropic-ai/claude-code

# agent-service: owns the Claude Code sessions for the VR client's conversation
# view, so they outlive the page (headset off, reload). agent-bridge is the thin
# relay the gateway runs via `docker exec -i` for each page connection: it joins
# stdin/stdout to the service's socket, starting the service if needed.
# `agent-service busy` exits 0 while a session is working (the idle reaper and
# update-worker ask). The SDK brings its own matching Claude Code binary, so it
# is independent of the CLI above.
COPY agent/package.json agent/package-lock.json /opt/agent-bridge/
RUN cd /opt/agent-bridge && npm ci --omit=dev
COPY agent/attach.mjs agent/service.mjs agent/session.mjs agent/login.mjs /opt/agent-bridge/
RUN printf '#!/bin/sh\nexec node /opt/agent-bridge/attach.mjs "$@"\n' > /usr/local/bin/agent-bridge && \
    printf '#!/bin/sh\nexec node /opt/agent-bridge/service.mjs "$@"\n' > /usr/local/bin/agent-service && \
    chmod +x /usr/local/bin/agent-bridge /usr/local/bin/agent-service

# Install watch-gh-build helper script
COPY scripts/watch-gh-build /usr/local/bin/watch-gh-build
COPY scripts/vr-sync /usr/local/bin/vr-sync
COPY scripts/update-worker /usr/local/bin/update-worker
RUN chmod +x /usr/local/bin/watch-gh-build /usr/local/bin/vr-sync /usr/local/bin/update-worker

# Install the VS Code CLI, used to run "code tunnel" for VS Code Remote
# Tunnels (browser or desktop VS Code access without any inbound port).
RUN curl -fL 'https://update.code.visualstudio.com/latest/cli-linux-x64/stable' --output /tmp/vscode_cli.tar.gz && \
    tar -xf /tmp/vscode_cli.tar.gz -C /usr/local/bin && \
    chmod +x /usr/local/bin/code && \
    rm /tmp/vscode_cli.tar.gz

# ttyd-session is run on demand by the gateway (`docker exec -it ... ttyd-session`)
# rather than by this container's own entrypoint -- each connection gets an
# independent tmux session by default, with the option to attach to
# (mirror) an existing one.
COPY scripts/ttyd-session /usr/local/bin/ttyd-session
RUN chmod +x /usr/local/bin/ttyd-session

# Create non-root user with /workspace as home
RUN useradd -m -d /workspace -s /bin/bash claude && \
    passwd -l claude && \
    echo "claude ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

COPY entrypoint-worker.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
